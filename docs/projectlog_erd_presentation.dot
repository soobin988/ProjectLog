digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.5", nodesep="0.45", ranksep="0.9", splines=spline, fontname="Arial", label="PROJECT LOG | CORE DATA FLOW", labelloc=t, fontsize=28];
node [shape=box, margin=0, color="#dce2e8", fontname="Arial"];
edge [color="#a2aab3", arrowsize=0.7, penwidth=1.2, fontname="Arial", fontsize=10];
subgraph cluster_accounts { label="ACCOUNT"; color="#e1e5e9"; style="rounded"; fontcolor="#526579"; margin=20;
"projectlog_users" [group="accounts", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#17212b"><FONT COLOR="white"><B>projectlog_users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">uid</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">google_subject</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(100)</FONT></TD></TR></TABLE>>];
}
subgraph cluster_projects { label="PROJECT & WORK"; color="#e1e5e9"; style="rounded"; fontcolor="#526579"; margin=20;
"node_files" [group="projects", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#007fff"><FONT COLOR="white"><B>node_files</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">revision_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">original_name</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">file_path</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(255)</FONT></TD></TR></TABLE>>];
"node_revisions" [group="projects", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#007fff"><FONT COLOR="white"><B>node_revisions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">mediumtext</FONT></TD></TR></TABLE>>];
"nodes" [group="projects", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#007fff"><FONT COLOR="white"><B>nodes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">parent_node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">error_status</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">issue_type</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">work_date</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">date</FONT></TD></TR></TABLE>>];
"projects" [group="projects", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#007fff"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">progress</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">date</FONT></TD></TR></TABLE>>];
}
subgraph cluster_feedback { label="AI FEEDBACK & ACTION"; color="#e1e5e9"; style="rounded"; fontcolor="#526579"; margin=20;
"feedback_actions" [group="feedback", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#1769aa"><FONT COLOR="white"><B>feedback_actions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">feedback_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">action_content</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">datetime(3)</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#1769aa">success | failed | pending</FONT></TD></TR></TABLE>>];
"feedbacks" [group="feedback", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#1769aa"><FONT COLOR="white"><B>feedbacks</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">mode</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">mediumtext</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">selected</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">regenerated_from</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">next_node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">datetime(3)</FONT></TD></TR></TABLE>>];
}
subgraph cluster_activity { label="TODO & ACTIVITY"; color="#e1e5e9"; style="rounded"; fontcolor="#526579"; margin=20;
"todos" [group="activity", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#526579"><FONT COLOR="white"><B>todos</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">feedback_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">due_date</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">date</FONT></TD></TR></TABLE>>];
}
subgraph cluster_portfolio { label="PORTFOLIO"; color="#e1e5e9"; style="rounded"; fontcolor="#526579"; margin=20;
"portfolio_analyses" [group="portfolio", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#34495e"><FONT COLOR="white"><B>portfolio_analyses</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">portfolio_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">analysis_content</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">mediumtext</FONT></TD></TR></TABLE>>];
"portfolio_files" [group="portfolio", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#f4f6f8"><TR><TD COLSPAN="3" BGCOLOR="#34495e"><FONT COLOR="white"><B>portfolio_files</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">FK</FONT></TD><TD ALIGN="LEFT">portfolio_id</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">char(36)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">original_name</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">file_path</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">is_thumbnail</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#007fff">&#160;</FONT></TD><TD ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT"><FONT COLOR="#7a838e">int unsigned</FONT></TD></TR></TABLE>>];
