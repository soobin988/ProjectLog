"feedbacks" -> "feedback_actions" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="1", tooltip="feedback_id | ON DELETE CASCADE", color="#007fff", penwidth=2.3];
"nodes" -> "feedbacks" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="1", tooltip="node_id | ON DELETE CASCADE", color="#007fff", penwidth=2.3];
"nodes" -> "node_files" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="1", tooltip="node_id | ON DELETE CASCADE"];
"nodes" -> "node_revisions" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="1", tooltip="node_id | ON DELETE CASCADE"];
"projects" -> "nodes" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="1", tooltip="project_id | ON DELETE CASCADE", color="#007fff", penwidth=2.3];
"nodes" -> "nodes" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="0..1", tooltip="parent_node_id | ON DELETE SET NULL"];
"portfolios" -> "portfolio_analyses" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="0..1", tooltip="portfolio_id | ON DELETE CASCADE"];
