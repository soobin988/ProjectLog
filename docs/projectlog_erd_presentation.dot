"projects" -> "portfolios" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="0..1", tooltip="project_id | ON DELETE SET NULL"];
"projectlog_users" -> "portfolios" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="1", tooltip="user_id | ON DELETE CASCADE"];
"projectlog_users" -> "projects" [dir=both, arrowtail=tee, arrowhead=crow, headlabel="0..N", taillabel="1", tooltip="user_id | ON DELETE CASCADE"];
