<%- include('partials/start') %>
<header class="page-heading">
  <div><h1><%= project.name %></h1><% if (project.tech) { %><p><%= project.tech %></p><% } %></div>
  <div class="actions project-actions">
    <a class="button" href="/portfolio/new?project=<%= project.id %>">Portfolio에 추가</a>
    <a class="button" href="/projects/<%= project.id %>/edit">수정</a>
  </div>
</header>
<section class="panel progress-panel" aria-label="프로젝트 진행 현황">
  <div class="row-heading"><h2>진행률 <span class="accent" data-progress-value><%= project.progress %>%</span></h2><span class="status <%= project.progress === 100 ? 'resolved' : 'work' %>"><%= project.progress === 100 ? '완료' : '진행 중' %></span></div>
  <% if (project.progress < 100) { %>
    <form method="post" action="/projects/<%= project.id %>/progress" data-progress-form>
      <input class="project-progress-slider" type="range" name="progress" min="0" max="99" step="1" value="<%= project.progress %>" style="--progress-fill:<%= (project.progress / 99) * 100 %>%" aria-label="프로젝트 진행률" aria-valuetext="<%= project.progress %>%">
      <p class="error" role="status" data-progress-error></p>
      <button class="button" type="submit" data-progress-retry hidden>다시 저장</button>
      <noscript><button class="button">저장</button></noscript>
    </form>
  <% } else { %>
    <progress value="100" max="100" aria-label="프로젝트 진행률"></progress>
  <% } %>
  <div class="progress-actions">
    <% if (project.progress < 100) { %>
      <form method="post" action="/projects/<%= project.id %>/complete"><button class="button">프로젝트 완료</button></form>
    <% } else { %><a class="button" href="/projects/<%= project.id %>/report">완료 리포트 ↗</a><% } %>
  </div>
</section>
<section class="timeline" id="node-search" aria-label="타임라인">
  <div class="timeline-heading"><h2>타임라인</h2><div class="source-legend"><span><i class="dot"></i> 내가 작성·수정</span><span><i class="dot ai-tone"></i> AI 작성·수정</span></div></div>
  <form class="panel node-search" method="get" action="/projects/<%= project.id %>#node-search" role="search" aria-label="프로젝트 노드 검색">
    <div class="node-search-query">
      <input type="search" name="q" value="<%= query %>" maxlength="120" placeholder="노드, 설명, 피드백 검색" aria-label="검색어">
      <button class="button primary">검색</button>
    </div>
    <fieldset class="node-search-filters">
      <legend class="calendar-todo-status">노드 필터</legend>
      <% for (const [key, label] of nodeFilters) { %>
        <label><input type="checkbox" name="filter" value="<%= key %>" <%= activeFilters.includes(key) ? 'checked' : '' %>> <%= label %></label>
      <% } %>
      <% if (searching) { %><a class="text-link" href="/projects/<%= project.id %>#node-search">초기화</a><% } %>
    </fieldset>
    <% if (searching) { %><p class="muted">검색 결과 <%= resultCount %>건</p><% } %>
  </form>
  <% if (Object.keys(groups).length) { %>
    <div class="project-timeline-scroll" data-project-timeline <%= searching ? '' : 'data-follow-latest' %> role="region" aria-label="날짜순 작업 기록" tabindex="0">
      <div class="project-timeline-track">
        <% for (const [date, records] of Object.entries(groups)) { %>
          <section class="project-timeline-day">
            <h3><time datetime="<%= date %>"><%= shortDate(date) %></time><span><%= records.length %>건</span></h3>
            <div class="project-timeline-row">
              <% for (const { node, todo } of records) { %>
                <% if (todo) { %>
                  <article class="panel timeline-node" id="todo-completion-<%= todo.id %>">
                    <div class="row-heading">
                      <h4 class="record-title"><a href="/todos#todo-<%= todo.id %>"><%= todo.title %></a></h4>
                      <span class="status resolved">✓ 할 일 완료</span>
                    </div>
                    <time class="todo-meta" datetime="<%= todo.completedAt %>"><%= completionTime(todo) %></time>
                    <% if (todo.feedbackSource) { %><a class="text-link todo-meta" href="<%= feedbackSourceUrl(todo.feedbackSource) %>">원본 AI 피드백 ↗</a><% } %>
                  </article>
                <% } else { %>
                  <div class="project-timeline-entry">
                    <article class="panel timeline-node <%= node.ai?.title ? 'ai-tone' : '' %>" id="node-<%= node.id %>">
                      <div class="row-heading"><div class="record-heading"><h4 class="record-title"><a class="node-review-link" href="<%= nodeDetailUrl(node) %>"><%= node.title %></a></h4><% if (node.ai?.title) { %><span class="attribution">AI 작성·수정</span><% } %></div><%- include('partials/status', { node }) %></div>
                      <% if (node.previousFeedback) { %><a class="text-link todo-meta" href="<%= feedbackSourceUrl(node.previousFeedback) %>">이전 노드의 피드백 ↗</a><% } %>
                      <%- include('partials/record', { node, showFeedback: 'legacy' }) %>
                      <%- include('partials/feedback-branch', { node, fromList: false, showRequestLink: false }) %>
                      <div class="record-links project-timeline-actions">
                        <a class="text-link" href="/projects/<%= project.id %>/nodes/<%= node.id %>/edit">수정</a>
                      </div>
                    </article>
                    <% if (!node.feedback.length) { %>
                      <div class="project-timeline-feedback-action">
                        <a class="button feedback-trigger" href="/projects/<%= project.id %>/nodes/<%= node.id %>/feedback">✦ AI 피드백 요청</a>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              <% } %>
            </div>
          </section>
        <% } %>
        <a class="project-timeline-add" href="/projects/<%= project.id %>/nodes/new" aria-label="노드 추가" title="노드 추가">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </a>
      </div>
    </div>
  <% } else { %>
    <p class="panel empty"><%= searching ? '검색 조건에 맞는 노드가 없습니다.' : '아직 작업 기록이 없습니다. 첫 작업을 기록해 타임라인을 시작하세요.' %></p>
    <a class="project-timeline-add" href="/projects/<%= project.id %>/nodes/new" aria-label="노드 추가" title="노드 추가">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    </a>
  <% } %>
</section>
<%- include('partials/project-materials', { records: projectNodes(project.id) }) %>
<%- include('partials/end') %>
