<%- include('partials/start') %>
<header class="page-heading"><h1>Todo List</h1></header>
<div class="todo-layout">
  <div>
    <section class="panel form-panel todo-panel" aria-label="할 일 추가">
      <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
      <form class="todo-add" method="post" action="/todos">
        <input name="title" aria-label="할 일" placeholder="할 일을 입력하세요" required maxlength="160" value="<%= draft.title || '' %>">
        <button class="button primary">추가</button>
        <%- include('partials/todo-project', { selected: draft.projectId }) %>
      </form>
      <p class="error" data-todo-toggle-error role="alert" hidden></p>
    </section>
    <div class="todo-panel todo-groups" data-todo-groups>
      <section class="panel form-panel todo-group" aria-labelledby="todo-pending-title">
        <h2 id="todo-pending-title">할 일</h2>
        <% if (pending.length) { %>
          <ul><% for (const todo of pending) { %><%- include('partials/todo-row', { todo, editing }) %><% } %></ul>
        <% } else { %><p class="muted todo-group-empty">남은 할 일이 없어요.</p><% } %>
      </section>
      <section class="panel form-panel todo-group" aria-labelledby="todo-completed-title">
        <h2 id="todo-completed-title">완료</h2>
        <% if (todayDone.length) { %>
          <ul><% for (const todo of todayDone) { %><%- include('partials/todo-row', { todo, editing }) %><% } %></ul>
        <% } else { %><p class="muted todo-group-empty">이 페이지에 오늘 완료한 할 일이 없어요.</p><% } %>
        <% if (pastDone.length) { %>
          <details class="todo-history" id="todo-history-list" data-todo-history <%= pastDone.some(todo => todo.id === editing?.id) ? 'open' : '' %>>
            <summary>이 페이지의 이전 완료 기록</summary>
            <ul><% for (const todo of pastDone) { %><%- include('partials/todo-row', { todo, editing }) %><% } %></ul>
          </details>
        <% } %>
      </section>
    </div>
  </div>
  <section class="todo-panel todo-timeline" id="todo-timeline" aria-label="완료 타임라인" data-todo-timeline>
    <h2>완료 타임라인</h2>
    <form class="todo-timeline-search" method="get" action="/todos#todo-timeline">
      <input type="date" name="completedOn" aria-label="완료 날짜" value="<%= completedOn %>" required>
      <button class="button" type="submit">검색</button>
      <% if (completedOn) { %><a class="text-link" href="/todos#todo-timeline">검색 초기화</a><% } %>
    </form>
    <% if (completedOn) { %>
      <% if (matchingCompletions.length) { %><%- include('partials/todo-timeline-day', { date: completedOn, items: matchingCompletions }) %>
      <% } else { %><p class="panel empty">선택한 날짜에 완료 기록이 없어요.</p><% } %>
    <% } else { %>
      <% if (todayDone.length) { %><%- include('partials/todo-timeline-day', { date: today, items: todayDone }) %>
      <% } else { %><p class="panel empty">이 페이지에 오늘 완료 기록이 없어요.</p><% } %>
      <% if (Object.keys(pastTimeline).length) { %>
        <details class="todo-history" id="todo-history-timeline" data-todo-history>
          <summary>이 페이지의 이전 완료 기록</summary>
          <% for (const [date, items] of Object.entries(pastTimeline)) { %>
            <%- include('partials/todo-timeline-day', { date, items }) %>
          <% } %>
        </details>
      <% } %>
    <% } %>
  </section>
</div>
<div data-todo-pagination><%- include('partials/pagination') %></div>
<%- include('partials/end') %>
