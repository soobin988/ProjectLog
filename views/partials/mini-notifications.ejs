<details class="mini-notifications">
  <summary class="button bell-button" aria-label="알림<%= unreadAlerts ? ', 미확인 ' + unreadAlerts + '건' : '' %>" title="알림">
    <%- include('bell') %><span class="bell-count" aria-hidden="true" <%= unreadAlerts ? '' : 'hidden' %>><%= unreadAlerts %></span>
  </summary>
  <section class="panel mini-alert-panel" aria-labelledby="mini-alert-title">
    <header class="row-heading">
      <h2 id="mini-alert-title">최근 알림</h2>
      <a class="text-link" href="/notifications">전체 알림 ↗</a>
    </header>
    <% if (!recentAlerts.length) { %><p class="muted">새로 표시할 알림이 없습니다.</p><% } else { %>
      <ul class="mini-alert-list">
        <% for (const item of recentAlerts) { %>
          <li class="notification<%= item.read ? ' notification-read' : '' %>" style="--project-color:<%= item.project.color %>">
            <form action="/notifications/<%= item.id %>/read" method="post" data-mini-alert>
              <button type="submit" <%= item.read ? 'disabled' : '' %>>
                <span class="notification-meta"><%= item.type === 'feedback' ? 'AI 피드백' : '오류' %> · <%= item.project.name %> · <%= shortDate(item.date) %></span>
                <strong><%= item.title %></strong>
                <span class="notification-state"><%= item.read ? '✓ 확인함' : '미확인 · 눌러서 확인' %></span>
              </button>
            </form>
            <a class="notification-record" href="<%= item.destination %>">기록 보기 ↗</a>
          </li>
        <% } %>
      </ul>
      <p class="mini-alert-error" role="status"></p>
    <% } %>
  </section>
</details>
