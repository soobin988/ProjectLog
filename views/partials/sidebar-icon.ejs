<% if (icon === 'bell') { %>
  <%- include('bell') %>
<% } else { %>
  <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <% if (icon === 'dashboard') { %>
      <rect x="3" y="3" width="7" height="7" rx="1.4"/><rect x="14" y="3" width="7" height="7" rx="1.4"/>
      <rect x="3" y="14" width="7" height="7" rx="1.4"/><rect x="14" y="14" width="7" height="7" rx="1.4"/>
    <% } else if (icon === 'folder') { %>
      <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    <% } else if (icon === 'portfolio') { %>
      <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M3 13h18m-11 0v2h4v-2"/>
    <% } else if (icon === 'developer') { %>
      <path d="M12 22s7-3.5 7-9V5l-7-3-7 3v8c0 5.5 7 9 7 9z"/><path d="m9 12 2 2 4-4"/>
    <% } else if (icon === 'suggestions') { %>
      <path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-9l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm4 5h8m-8 3h6"/>
    <% } else if (icon === 'settings') { %>
      <path d="m10 3-.5 2.6-1.4.8-2.5-.9-2 3.5 2 1.7v1.6l-2 1.7 2 3.5 2.5-.9 1.4.8.5 2.6h4l.5-2.6 1.4-.8 2.5.9 2-3.5-2-1.7v-1.6l2-1.7-2-3.5-2.5.9-1.4-.8L14 3z"/>
      <circle cx="12" cy="11.5" r="2.8"/>
    <% } else { %>
      <rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8 12 3 3 5-6"/>
    <% } %>
  </svg>
<% } %>
