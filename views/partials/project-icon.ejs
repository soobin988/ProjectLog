<svg class="project-icon" data-project-icon="<%= icon %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% if (icon === 'file') { %>
    <path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6m-6 4h6"/>
  <% } else if (icon === 'drawing') { %>
    <rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m3 17 5-4 3 2 4-5 6 6"/>
  <% } else if (icon === 'workout') { %>
    <rect x="5" y="6" width="3" height="12" rx="1"/><rect x="16" y="6" width="3" height="12" rx="1"/><path d="M8 12h8m-13-3v6m18-6v6"/>
  <% } else if (icon === 'study') { %>
    <path d="M12 6c-3-3-6-3-9-2v14c3-1 6-1 9 2 3-3 6-3 9-2V4c-3-1-6-1-9 2zm0 0v14"/>
  <% } else if (icon === 'code') { %>
    <path d="m8 6-6 6 6 6m8-12 6 6-6 6m-2-15-4 18"/>
  <% } else if (icon === 'folder') { %>
    <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
  <% } %>
</svg>
