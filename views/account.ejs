<% const accountTitle = signup ? '회원가입' : '로그인'; %>
<%- include('partials/start', { page: 'account', title: accountTitle, guestsOnly: true }) %>
<div class="account-page">
  <section class="panel form-panel account-panel">
    <h1><%= accountTitle %></h1>
    <% if (typeof dataReset !== 'undefined' && dataReset) { %><p class="account-notice" role="status">유저 데이터를 삭제했어요. 다시 로그인해 주세요.</p><% } %>
    <% if (typeof cleanupPending !== 'undefined' && cleanupPending) { %><p class="account-notice error" role="alert">일부 첨부 파일을 서버에서 지우지 못했어요. 서버 로그를 확인해 주세요.</p><% } %>
    <% if (error) { %><p class="account-notice error" role="alert"><%= error %></p><% } %>
    <form method="post" action="<%= signup ? '/register' : '/login' %>">
      <label>아이디<input name="username" autocomplete="username" autocapitalize="none" required maxlength="40" value="<%= username %>"></label>
      <label>비밀번호<input type="password" name="password" autocomplete="<%= signup ? 'new-password' : 'current-password' %>" required maxlength="<%= passwordMaxLength %>"<% if (signup) { %> minlength="<%= passwordMinLength %>"<% } %>></label>
      <button class="button primary"><%= signup ? '계정 만들기' : '로그인' %></button>
    </form>
    <form class="account-google-form" method="get" action="/auth/google">
      <button class="button account-google" type="submit"<% if (!googleEnabled) { %> disabled aria-describedby="google-login-status"<% } %>>
        <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.22 5.48-4.73 7.18l7.73 6C44.45 38.03 46.98 31.87 46.98 24.55z"/>
          <path fill="#FBBC05" d="M10.53 28.59a14.4 14.4 0 0 1 0-9.18l-7.98-6.19a24 24 0 0 0 0 21.56z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.91-5.8l-7.73-6c-2.15 1.45-4.92 2.3-8.18 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.5 42.62 14.61 48 24 48z"/>
        </svg>
        Google로 계속하기
      </button>
      <% if (!googleEnabled) { %><p class="muted account-google-status" id="google-login-status">Google 로그인 연결이 필요해요.</p><% } %>
    </form>
    <div class="account-switch">
      <p><%= signup ? '이미 계정이 있나요?' : '처음 이용하시나요?' %></p>
      <a class="button" href="<%= signup ? '/login' : '/register' %>"><%= signup ? '로그인' : '회원가입' %></a>
    </div>
  </section>
</div>
<%- include('partials/end') %>
