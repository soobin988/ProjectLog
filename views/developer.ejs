<%- include('partials/start') %>
<header class="page-heading">
  <h1>개발자 전용</h1>
  <button class="button" type="button" data-open-update-publisher aria-haspopup="dialog" aria-controls="update-publisher">업데이트 공지 보내기</button>
</header>
<% if (updatePublished) { %><p class="developer-result" role="status">업데이트 공지를 보냈어요. 환경설정의 업데이트 내역에서 확인할 수 있어요.</p><% } %>
<dialog class="panel form-panel update-publisher" id="update-publisher" aria-labelledby="update-publisher-title"<%= updateError ? ' data-reopen' : '' %>>
  <header class="row-heading">
    <h2 id="update-publisher-title">업데이트 공지 보내기</h2>
    <form method="dialog"><button class="button">닫기</button></form>
  </header>
  <% if (updateError) { %><p class="error" role="alert"><%= updateError %></p><% } %>
  <form action="/developer/updates" method="post">
    <label>버전<input name="version" value="<%= updateDraft.version ?? currentVersion %>" maxlength="32" placeholder="1.0.0" required></label>
    <label>제목<input name="title" value="<%= updateDraft.title || '' %>" maxlength="160" required></label>
    <label>업데이트 내용<textarea name="content" rows="9" maxlength="12000" required><%= updateDraft.content || '' %></textarea></label>
    <div class="actions"><button class="button primary">공지 보내기</button></div>
  </form>
</dialog>
<section class="stats developer-stats" aria-label="회원 및 사용량 요약">
  <% for (const [label, value] of [
    ['등록된 회원 / 상한', units(memberCount) + ' / ' + units(memberLimit) + '명'],
    ['활동 시간', duration(totals.seconds)],
    ['AI 요청', units(totals.requests) + '건'],
    ['보고된 토큰', units(totals.totalTokens)]
  ]) { %>
    <div class="panel stat"><span><%= label %></span><strong><%= value %></strong></div>
  <% } %>
</section>
<section class="panel form-panel developer-members developer-limit" aria-labelledby="developer-limit-title">
  <h2 id="developer-limit-title">회원 수 상한</h2>
  <form class="developer-filters" action="/developer/member-limit" method="post">
    <label>최대 회원 수<input type="number" name="limit" min="1" max="<%= maxMemberLimit %>" value="<%= memberLimit %>" required></label>
    <button class="button" type="submit">상한 저장</button>
  </form>
  <p class="muted developer-metrics-note">회원 수가 상한에 도달하면 새 가입이 중단돼요. 상한을 현재 인원보다 낮춰도 기존 회원은 로그인할 수 있어요.</p>
  <% if (limitError) { %><p class="error" role="alert"><%= limitError %></p><% } %>
  <% if (limitSaved) { %><p role="status">회원 수 상한을 저장했어요.</p><% } %>
</section>
<% if (deleted) { %><p class="developer-result" role="status">아이디와 유저 데이터를 삭제했어요.</p><% } %>
<% if (cleanupFailed) { %><p class="developer-result error" role="alert">일부 첨부 파일을 서버에서 지우지 못했어요. 서버 로그를 확인해 주세요.</p><% } %>
<section class="panel form-panel developer-members" aria-labelledby="developer-members-title">
  <div class="row-heading"><h2 id="developer-members-title">회원 관리</h2></div>
  <form class="developer-filters" action="/developer" method="get">
    <label>기간
      <select name="period">
        <% for (const [key, label] of Object.entries(periods)) { %><option value="<%= key %>" <%= period === key ? 'selected' : '' %>><%= label %></option><% } %>
      </select>
    </label>
    <label>회원 검색<input type="search" name="q" maxlength="80" placeholder="UID, 이름 또는 아이디" value="<%= query %>"></label>
    <button class="button" type="submit">적용</button>
  </form>
  <p class="muted developer-metrics-note">활동 시간은 로그인 후 화면이 보이는 동안 측정해요. 1분 동안 입력이 없으면 집계를 멈추고, 여러 탭에서 보낸 시간은 한 번만 계산해요. 토큰은 OpenAI가 보고한 수치예요.</p>
  <div class="developer-table-wrap">
    <table class="developer-table">
      <thead><tr><th scope="col">회원</th><th scope="col">UID</th><th scope="col">로그인</th><th scope="col">활동 시간</th><th scope="col">AI 요청</th><th scope="col">보고 토큰</th><th scope="col">최근 활동</th></tr></thead>
      <tbody>
        <% for (const member of members) { %>
          <tr>
            <th scope="row"><a class="text-link" href="/developer/members/<%= member.uid %>?period=<%= period %>"><%= member.name %></a><% if (member.username && member.username !== member.name) { %><small><%= member.username %></small><% } %></th>
            <td><%= member.uid %></td>
            <td><%= member.google ? 'Google' : '아이디' %><% if (member.uid === account.uid) { %><small>개발자</small><% } %></td>
            <td><%= duration(member.seconds) %></td>
            <td><%= units(member.requests) %>건<% if (Number(member.failures)) { %><small>실패 <%= units(member.failures) %>건</small><% } %></td>
            <td><%= units(member.totalTokens) %></td>
            <td><%= lastActive(member.lastActive) %></td>
          </tr>
        <% } %>
        <% if (!members.length) { %><tr><td colspan="7" class="muted">조건에 맞는 회원이 없어요.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/end') %>
