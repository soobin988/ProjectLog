<%- include('partials/start') %>
<header class="page-heading"><h1>프로젝트</h1></header>
<% if (cleanupPending) { %><p class="error" role="alert">프로젝트를 삭제했지만 일부 첨부 파일을 정리하지 못했어요.</p><% } %>
<nav class="project-category-tabs" aria-label="프로젝트 카테고리">
  <a href="/projects" <%- !activeCategory ? 'aria-current="page"' : '' %>>전체</a>
  <% for (const [key, label] of Object.entries(categories)) { %>
    <a href="/projects?category=<%= key %>" <%- activeCategory === key ? 'aria-current="page"' : '' %>><%= label %></a>
  <% } %>
</nav>
<% if (creating) { %>
  <section class="panel form-panel" id="new-project">
    <h2>새 프로젝트</h2>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="post" action="<%= listUrl %>">
      <%- include('partials/project-fields') %>
      <div class="actions"><a class="button" href="<%= listUrl %>">취소</a><button class="button primary">프로젝트 만들기</button></div>
    </form>
  </section>
<% } %>
<div class="project-list">
  <% for (const project of projects) {  %>
    <section class="panel project-panel" style="--project-color:<%= project.color %>" data-project data-strip-url="/projects/<%= project.id %>/strip">
      <header class="project-head">
        <span class="tile project-tile"><%- include('partials/project-icon', { icon: projectIconFor(project) }) %></span>
        <div class="project-heading">
          <div class="project-title-row"><h2><a class="project-detail-link" href="/projects/<%= project.id %>"><%= project.name %></a></h2><span class="project-category-label"><%= categories[categoryFor(project)] %></span></div>
          <% if (project.tech || project.summary) { %><p><%= project.tech || project.summary %></p><% } %>
        </div>
        <span class="status <%= project.progress === 100 ? 'resolved' : 'work' %>"><%= project.progress === 100 ? '완료' : '진행 중' %></span>
        <div class="project-progress"><progress value="<%= project.progress %>" max="100" aria-label="진행률"></progress><span><%= project.progress %>%</span></div>
        <button class="project-head-toggle" type="button" aria-expanded="false" aria-controls="expand-<%= project.id %>" aria-label="<%= project.name %> 작업 노드">
          <svg class="project-head-chevron" viewBox="0 0 28 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m4 3 10 5 10-5M4 8l10 5 10-5"/>
          </svg>
        </button>
      </header>
      <div class="project-expand" id="expand-<%= project.id %>" hidden>
        <p class="muted" data-strip-status role="status"></p>
        <button class="button" type="button" data-strip-retry hidden>다시 불러오기</button>
      </div>
    </section>
  <% } %>
  <% if (!projects.length) { %><p class="panel empty"><%= activeCategory ? categories[activeCategory] + ' 카테고리에 프로젝트가 없습니다.' : '아직 프로젝트가 없습니다.' %></p><% } %>
</div>
<%- include('partials/end') %>
