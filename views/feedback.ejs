<%- include('partials/start', { breadcrumbLinks: [{ label: project.name, href: '/projects/' + project.id },
  { label: regenerating ? '이전 피드백' : node.title, href: back }] }) %>
<div data-feedback-request-content>
  <header class="page-heading"><h1><%= title %></h1></header>
  <div class="feedback-grid">
    <section class="panel form-panel">
      <h2>작업 기록</h2>
      <p class="record-heading record-context feedback-request-node <%= node.ai?.title ? 'ai-tone' : '' %>">
        <strong class="record-title"><%= node.title %></strong><time datetime="<%= node.date %>"><%= shortDate(node.date) %></time>
        <% if (node.ai?.title) { %><span class="attribution">AI 작성·수정</span><% } %>
      </p>
      <%- include('partials/record', { node, showFeedback: false }) %>
      <a class="text-link" href="/projects/<%= project.id %>/nodes/<%= node.id %>/edit">수정 <span aria-hidden="true">↗</span></a>
    </section>
    <section class="panel form-panel">
      <% if (error || !configured) { %><p class="error" role="alert"><%= error || 'AI 요청을 사용하려면 서버에 OPENAI_API_KEY를 설정하세요.' %></p><% } %>
      <form method="post" data-feedback-form>
        <label>답변 성격<select name="style" required><% for (const [mode, label] of Object.entries(styles)) { %><option value="<%= mode %>" <%= mode === draft.mode ? 'selected' : '' %>><%= label %></option><% } %></select></label>
        <label>요청 내용<textarea name="request" rows="6" maxlength="3000" placeholder="예. 이 오류가 재발하지 않도록 확인할 항목을 알려줘." required><%= draft.request %></textarea></label>
        <p class="muted">요청 내용과 이 노드의 작업 기록 및 첨부 코드를 OpenAI로 전송합니다.<% if (imageCount) { %> 첨부 이미지 <%= imageCount %>장도 함께 전송합니다.<% } %><% if (archiveCount) { %> 첨부 ZIP <%= archiveCount %>개도 검토를 위해 전송합니다.<% } %></p>
        <button class="button dark feedback-submit" type="submit">
          <span class="feedback-submit-label"><span aria-hidden="true">✦</span> <%= regenerating ? '추가 피드백 생성' : '요청하기' %></span>
        </button>
      </form>
    </section>
  </div>
</div>
<div class="feedback-analysis-overlay" data-feedback-analysis-overlay role="status" aria-live="polite" aria-atomic="true" tabindex="-1" hidden>
  <div class="feedback-analysis-progress">
    <span class="feedback-spinner" aria-hidden="true"></span>
    <p>분석 중…</p>
  </div>
</div>
<%- include('partials/end') %>
