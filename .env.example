# Copy to .env and replace change_me with your own database password.
# .env is loaded explicitly with: node --env-file=.env app.js
NODE_ENV=development
PORT=3000
PROJECT_LOG_HOST=127.0.0.1
PROJECT_LOG_PUBLIC_ORIGIN=http://localhost:3000
PROJECT_LOG_MYSQL_URL=mysql://projectlog:change_me@127.0.0.1:3306/projectlog

# Optional: set your own UID after registering the developer account.
# PROJECT_LOG_DEVELOPER_UID=10000

# Optional AI / Google sign-in. Leave unset to keep these integrations disabled.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional external storage paths. Parent folders must be writable by the app.
# PROJECT_LOG_DATA_FILE=/home/ubuntu/project-log-data/project-log-data.json
# PROJECT_LOG_PORTFOLIO_UPLOADS=/home/ubuntu/project-log-data/portfolio
# PROJECT_LOG_BACKUPS=/home/ubuntu/project-log-data/backups

# Optional isolated test database; the database name must start with projectlog_test_.
# PROJECT_LOG_TEST_MYSQL_URL=mysql://projectlog:change_me@127.0.0.1:3306/projectlog_test_run

# Optional ERD regeneration tools; not needed to run the web app.
# PROJECT_LOG_TOOL_MODULES=/absolute/path/to/erd-tools/node_modules
# PROJECT_LOG_CHROME=/absolute/path/to/chrome
